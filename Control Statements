        System.out.println("Enter first number");
        int num1=sc.nextInt();
        System.out.println("Enter second number");
        int num2=sc.nextInt();
        System.out.println("Enter third number");
        int num3=sc.nextInt();
        if(num1<=num2){
            if(num1<=num3){
                System.out.println("Condition 1: " +num1+ " is the smallest number");
            }
            else{
                System.out.println("Condition 2: " +num2+ " is the smallest number");
            }
        
        }
